{
  "name": "qaxiom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-pdf.mjs",
    "prebuild": "node scripts/prepare-pdf.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:retrieval": "vitest run src/services/retrieval/evaluation.test.ts --disableConsoleIntercept",
    "eval:real-retrieval": "QAXIOM_REAL_EVAL=1 vitest run scripts/evaluation/real-retrieval.test.ts --disableConsoleIntercept",
    "bench:retrieval": "vitest bench src/services/retrieval/performance.bench.ts --run",
    "bench:browser-retrieval": "QAXIOM_RUN_PERF=1 playwright test e2e/retrieval.perf.spec.ts --workers=1",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "katex": "^0.19.0",
    "lucide-react": "^1.50.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
